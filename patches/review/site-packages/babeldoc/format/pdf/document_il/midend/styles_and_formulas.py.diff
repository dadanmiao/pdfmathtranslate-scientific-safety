+    def attach_image_formula_lines(self, page: Page):
+        """Keep a bitmap-only line inside its surrounding text paragraph."""
+        for paragraph in page.pdf_paragraph:
+            if paragraph.debug_id is None or not paragraph.box:
+                continue
+            comps = paragraph.pdf_paragraph_composition
+            text_lines = [c.pdf_line for c in comps if c.pdf_line and c.pdf_line.pdf_character]
+            if len(text_lines) < 2:
+                continue
+            heights = sorted(ch.box.y2 - ch.box.y for line in text_lines for ch in line.pdf_character if ch.box)
+            if not heights:
+                continue
+            height = heights[len(heights) // 2]
+            if height <= 0:
+                continue
+            centers = [(line.box.y + line.box.y2) / 2 for line in text_lines]
+            images = []
+            for form in page.pdf_form:
+                if not form.box or not form.pdf_form_subtype or not form.pdf_form_subtype.pdf_inline_form or form.xobj_id != paragraph.xobj_id:
+                    continue
+                if self.is_protected_image(form, page):
+                    continue
+                b = form.box
+                x, y = (b.x + b.x2) / 2, (b.y + b.y2) / 2
+                if not (paragraph.box.x <= x <= paragraph.box.x2 and paragraph.box.y <= y <= paragraph.box.y2):
+                    continue
+                if not (0 < b.x2 - b.x <= height * 2 and 0 < b.y2 - b.y <= height * 1.5):
+                    continue
+                above = [center for center in centers if center > y]
+                below = [center for center in centers if center < y]
+                if not above or not below:
+                    continue
+                top, bottom = min(above), max(below)
+                if top - bottom < height * 1.5 or min(top - y, y - bottom) < height * 0.35:
+                    continue
+                images.append((y, form, top, bottom))
+            groups = {}
+            for y, form, top, bottom in images:
+                groups.setdefault((top, bottom), []).append(form)
+            for (top, bottom), forms in groups.items():
+                if len(forms) < 2:
+                    continue
+                box = Box(min(f.box.x for f in forms), min(f.box.y for f in forms),
+                          max(f.box.x2 for f in forms), max(f.box.y2 for f in forms))
+                composition = PdfParagraphComposition(pdf_formula=PdfFormula(
+                    box=box, pdf_form=forms, x_offset=0, y_offset=0, x_advance=0,
+                ))
+                index = next((i for i, comp in enumerate(comps)
+                              if comp.pdf_line and comp.pdf_line.box and
+                              (comp.pdf_line.box.y + comp.pdf_line.box.y2) / 2 < (top + bottom) / 2), len(comps))
+                comps.insert(index, composition)
+                for form in forms:
+                    page.pdf_form.remove(form)
+
+    def attach_inline_image_formulas(self, page: Page):
+        """Preserve small inline image glyphs as movable formula placeholders."""
+        lines = []
+        for paragraph in page.pdf_paragraph:
+            if paragraph.debug_id is None:
+                continue
+            for composition in paragraph.pdf_paragraph_composition:
+                if composition.pdf_line and len(composition.pdf_line.pdf_character) >= 2:
+                    lines.append((paragraph, composition, composition.pdf_line.pdf_character))
+
+        assigned = {}
+        for form in page.pdf_form:
+            if not form.box or not form.pdf_form_subtype or not form.pdf_form_subtype.pdf_inline_form:
+                continue
+            if self.is_protected_image(form, page):
+                continue
+            box = form.box
+            candidates = []
+            for paragraph, composition, chars in lines:
+                if form.xobj_id != paragraph.xobj_id:
+                    continue
+                if not any(c.box and c.char_unicode and not c.char_unicode.isspace() for c in chars):
+                    continue
+                heights = sorted(c.box.y2 - c.box.y for c in chars if c.box)
+                if not heights:
+                    continue
+                height = heights[len(heights) // 2]
+                if height <= 0 or not (0 < box.x2 - box.x <= height * 2 and 0 < box.y2 - box.y <= height * 1.5):
+                    continue
+                cy = (box.y + box.y2) / 2
+                char_y = sum((c.box.y + c.box.y2) / 2 for c in chars if c.box) / len(heights)
+                if abs(cy - char_y) > height * 0.55:
+                    continue
+                if not paragraph.box or not (paragraph.box.x - height <= box.x and box.x2 <= paragraph.box.x2 + height):
+                    continue
+                if any(c.box and c.char_unicode and not c.char_unicode.isspace() and min(c.box.x2, box.x2) - max(c.box.x, box.x) > height * 0.3 for c in chars):
+                    continue
+                before = min((c for c in chars if c.box and c.char_unicode and not c.char_unicode.isspace()), key=lambda c: abs((c.box.x + c.box.x2) / 2 - (box.x + box.x2) / 2))
+                horizontal = abs((before.box.x + before.box.x2) / 2 - (box.x + box.x2) / 2)
+                candidates.append((abs(cy - char_y) + horizontal * 0.01, paragraph, composition, before))
+            if candidates:
+                _, paragraph, composition, before = min(candidates, key=lambda item: item[0])
+                assigned.setdefault(id(composition), []).append((form, before))
+
+        for paragraph, composition, chars in lines:
+            entries = assigned.get(id(composition))
+            if not entries:
+                continue
+            chars = [c for c in chars if not (
+                c.box and c.char_unicode and c.char_unicode.isspace() and c.pdf_character_id is None
+                and any(c.box.x < f.box.x2 and c.box.x2 > f.box.x for f, _ in entries)
+            )]
+            entries.sort(key=lambda item: (item[0].box.x, -item[0].box.y))
+            groups = []
+            heights = sorted(c.box.y2 - c.box.y for c in chars if c.box)
+            gap = heights[len(heights) // 2] * 0.5
+            for form, before in entries:
+                right_edge = max((f.box.x2 for f in groups[-1][0]), default=0) if groups else 0
+                intervening = any(right_edge < (c.box.x + c.box.x2) / 2 < form.box.x for c in chars if c.box)
+                if groups and form.box.x <= right_edge + gap and not intervening:
+                    groups[-1][0].append(form)
+                else:
+                    groups.append(([form], before))
+            pieces, pending = [], []
+            events = [(c.box.x + (c.box.x2 - c.box.x) / 2, 1, c) for c in chars]
+            events += [((min(f.box.x for f in forms) + max(f.box.x2 for f in forms)) / 2, 0, (forms, before)) for forms, before in groups]
+            for _, kind, value in sorted(events, key=lambda event: (event[0], event[1])):
+                if kind:
+                    pending.append(value)
+                    continue
+                if pending:
+                    line = PdfLine(pdf_character=pending)
+                    self.update_line_data(line)
+                    pieces.append(PdfParagraphComposition(pdf_line=line))
+                    pending = []
+                forms, before = value
+                box = Box(min(f.box.x for f in forms), min(f.box.y for f in forms),
+                          max(f.box.x2 for f in forms), max(f.box.y2 for f in forms))
+                pieces.append(PdfParagraphComposition(pdf_formula=PdfFormula(
+                    box=box, pdf_form=forms, x_offset=0,
+                    y_offset=box.y - before.box.y, x_advance=0,
+                )))
+                for form in forms:
+                    page.pdf_form.remove(form)
+            if pending:
+                line = PdfLine(pdf_character=pending)
+                self.update_line_data(line)
+                pieces.append(PdfParagraphComposition(pdf_line=line))
+            index = paragraph.pdf_paragraph_composition.index(composition)
+            paragraph.pdf_paragraph_composition[index:index + 1] = pieces
+
+    @staticmethod
+    def is_protected_image(form, page):
+        box = form.box
+        area = (box.x2 - box.x) * (box.y2 - box.y)
+        if area <= 0:
+            return False
+        for layout in page.page_layout:
+            if layout.class_name not in ('figure', 'image', 'table'):
+                continue
+            bounds = layout.box
+            overlap = max(0, min(box.x2, bounds.x2) - max(box.x, bounds.x)) * max(0, min(box.y2, bounds.y2) - max(box.y, bounds.y))
+            if overlap / area >= 0.3:
+                return True
+        return False
 
