--- a/site-packages/babeldoc/format/pdf/document_il/utils/scoped_rendering.py
+++ b/site-packages/babeldoc/format/pdf/document_il/utils/scoped_rendering.py
@@ -0,0 +1,88 @@
+"""Emit relocated Form text in page coordinates, retaining scoped font encodings."""
+import copy
+
+
+def _resources(doc,page):
+    current=page.xref
+    while current:
+        kind,value=doc.xref_get_key(current,"Resources")
+        if kind=="xref": return int(value.split()[0])
+        if kind=="dict":
+            ref=doc.get_new_xref()
+            doc.update_object(ref,value)
+            doc.xref_set_key(page.xref,"Resources",f"{ref} 0 R")
+            return ref
+        kind,parent=doc.xref_get_key(current,"Parent")
+        current=int(parent.split()[0]) if kind=="xref" else 0
+    ref=doc.get_new_xref()
+    doc.update_object(ref,"<< /Font << >> >>")
+    doc.xref_set_key(page.xref,"Resources",f"{ref} 0 R")
+    return ref
+
+
+def register_original_font(doc,page,alias,xref):
+    ref=_resources(doc,page)
+    kind,value=doc.xref_get_key(ref,"Font")
+    if kind=="xref":
+        doc.xref_set_key(int(value.split()[0]),alias,f"{xref} 0 R")
+    else:
+        if kind=="null": doc.xref_set_key(ref,"Font","<< >>")
+        doc.xref_set_key(ref,"Font/"+alias,f"{xref} 0 R")
+
+
+def edited_form_xrefs(document):
+    result=set()
+    for page in document.page:
+        scopes={x.xobj_id:x for x in page.pdf_xobject}
+        for paragraph in page.pdf_paragraph:
+            for composition in paragraph.pdf_paragraph_composition:
+                char=composition.pdf_character
+                if char and char.xobj_id in scopes:
+                    result.add(scopes[char.xobj_id].xref_id)
+    return result
+
+
+def promote_form_text(doc,page,units,edited_xrefs,added_font_ids):
+    """A relocated unit must not be clipped by its original tiny Form BBox.
+
+    All text in an edited/shared Form is emitted once in page coordinates.
+    Source font dictionaries are referenced directly, without recoding CIDs.
+    The Form retains its non-text drawing operations.
+    """
+    scopes={x.xobj_id:x for x in page.pdf_xobject}
+    page_fonts={f.font_id:f for f in page.pdf_font}
+    aliases={}
+    result=[]
+    for unit in units:
+        scope=scopes.get(unit.xobj_id)
+        if scope is None or scope.xref_id not in edited_xrefs:
+            result.append(unit)
+            continue
+        if hasattr(unit,"char"):
+            copied=copy.copy(unit)
+            copied.char=copy.copy(unit.char)
+            copied.char.pdf_style=copy.copy(unit.char.pdf_style)
+            font_id=copied.char.pdf_style.font_id
+            if font_id not in added_font_ids:
+                local={f.font_id:f for f in scope.pdf_font}
+                font=local.get(font_id,page_fonts.get(font_id))
+                if font is None:
+                    raise ValueError("Cannot resolve the original scoped font.")
+                alias=f"BDSource{font.xref_id}"
+                copied.char.pdf_style.font_id=alias
+                if alias not in aliases:
+                    register_original_font(doc,doc[page.page_number],alias,font.xref_id)
+                    mapped=copy.copy(font)
+                    mapped.font_id=alias
+                    page.pdf_font.append(mapped)
+                    aliases[alias]=mapped
+            copied.xobj_id=None
+            copied.char.xobj_id=None
+            result.append(copied)
+        elif hasattr(unit,"curve") and unit.curve.relocation_transform:
+            copied=copy.copy(unit)
+            copied.xobj_id=None
+            result.append(copied)
+        else:
+            result.append(unit)
+    return result,aliases
