--- a/site-packages/babeldoc/format/pdf/document_il/utils/render_integrity.py
+++ b/site-packages/babeldoc/format/pdf/document_il/utils/render_integrity.py
@@ -0,0 +1,88 @@
+"""Reject PDF output when planned glyphs disappear during rendering."""
+from collections import Counter
+import unicodedata
+
+import pymupdf
+
+from babeldoc.format.pdf.document_il.utils.scientific_text import TranslationIntegrityError
+
+
+def _count(text):
+    return Counter(c for c in unicodedata.normalize("NFKC",text)
+                   if not c.isspace() and unicodedata.category(c) not in ("Cf","Cc"))
+
+
+def _symbol_private_characters(page):
+    result = []
+    for block in page.get_text("rawdict")["blocks"]:
+        for line in block.get("lines", []):
+            for span in line["spans"]:
+                if span["font"].split("+")[-1] != "Symbol":
+                    continue
+                for char in span["chars"]:
+                    if unicodedata.category(char["c"]) == "Co":
+                        result.append((char["c"], char["bbox"][0], char["bbox"][1]))
+    return result
+
+
+def _account_for_original_symbols(missing, chars, page, source_page, output_page):
+    """Recognize unchanged Symbol glyphs whose Unicode mappings disagree."""
+    source = _symbol_private_characters(source_page)
+    rendered = _symbol_private_characters(output_page)
+    if not source or not rendered:
+        return missing
+    page_fonts = {f.font_id: f for f in page.pdf_font}
+    xobjects = {x.xobj_id: x for x in page.pdf_xobject}
+    used_source, used_rendered = set(), set()
+    for char in chars:
+        if char.pdf_character_id is None or not char.char_unicode or not char.box or not char.pdf_style:
+            continue
+        contribution = _count(char.char_unicode) & missing
+        if not contribution:
+            continue
+        font = page_fonts.get(char.pdf_style.font_id)
+        if char.xobj_id in xobjects:
+            local = {f.font_id: f for f in xobjects[char.xobj_id].pdf_font}
+            font = local.get(char.pdf_style.font_id, font)
+        if not font or not font.name or font.name.split("+")[-1] != "Symbol":
+            continue
+        x, y = char.box.x, output_page.rect.height - char.box.y2
+        for si, (code, sx, sy) in enumerate(source):
+            if si in used_source or abs(sx-x) > 1 or abs(sy-y) > 1:
+                continue
+            for ri, (actual_code, rx, ry) in enumerate(rendered):
+                if ri not in used_rendered and actual_code == code and abs(rx-sx) <= 1 and abs(ry-sy) <= 1:
+                    missing -= contribution
+                    used_source.add(si)
+                    used_rendered.add(ri)
+                    break
+            else:
+                continue
+            break
+    return missing
+
+
+def validate_rendered_text(pdf, document, source_pdf_path=None):
+    for page in document.page:
+        chars=list(page.pdf_character)
+        for paragraph in page.pdf_paragraph:
+            chars.extend(c.pdf_character for c in paragraph.pdf_paragraph_composition if c.pdf_character)
+        expected=Counter()
+        for char in chars:
+            value=char.char_unicode
+            if char.pdf_character_id is None or not value or value.startswith("(cid:"):
+                continue
+            expected.update(_count(value))
+        actual=_count(pdf[page.page_number].get_text())
+        missing=expected-actual
+        if missing and source_pdf_path:
+            with pymupdf.open(source_pdf_path) as source_pdf:
+                missing = _account_for_original_symbols(
+                    missing, chars, page, source_pdf[page.page_number], pdf[page.page_number]
+                )
+        if missing:
+            raise TranslationIntegrityError(
+                f"PDF rendering quality check failed on page {page.page_number+1}: "
+                f"{sum(missing.values())} planned character(s) disappeared "
+                f"({', '.join(f'U+{ord(c):04X}x{n}' for c,n in list(missing.items())[:8])}). Output was stopped."
+            )
