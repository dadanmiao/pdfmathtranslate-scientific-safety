--- a/site-packages/babeldoc/format/pdf/document_il/utils/render_integrity.py
+++ b/site-packages/babeldoc/format/pdf/document_il/utils/render_integrity.py
@@ -0,0 +1,31 @@
+"""Reject PDF output when planned glyphs disappear during rendering."""
+from collections import Counter
+import unicodedata
+
+from babeldoc.format.pdf.document_il.utils.scientific_text import TranslationIntegrityError
+
+
+def _count(text):
+    return Counter(c for c in unicodedata.normalize("NFKC",text)
+                   if not c.isspace() and unicodedata.category(c) not in ("Cf","Cc"))
+
+
+def validate_rendered_text(pdf, document):
+    for page in document.page:
+        chars=list(page.pdf_character)
+        for paragraph in page.pdf_paragraph:
+            chars.extend(c.pdf_character for c in paragraph.pdf_paragraph_composition if c.pdf_character)
+        expected=Counter()
+        for char in chars:
+            value=char.char_unicode
+            if char.pdf_character_id is None or not value or value.startswith("(cid:"):
+                continue
+            expected.update(_count(value))
+        actual=_count(pdf[page.page_number].get_text())
+        missing=expected-actual
+        if missing:
+            raise TranslationIntegrityError(
+                f"PDF rendering quality check failed on page {page.page_number+1}: "
+                f"{sum(missing.values())} planned character(s) disappeared "
+                f"({', '.join(f'U+{ord(c):04X}x{n}' for c,n in list(missing.items())[:8])}). Output was stopped."
+            )
